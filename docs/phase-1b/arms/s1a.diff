     triggerElement.removeAttribute('aria-autocomplete');
+
+    // The role goes away with it, so the invalid state has to as well — the
+    // focusable trigger the consumer slotted in owns its own validity exposure.
+    triggerElement.removeAttribute('aria-invalid');
   }
 
