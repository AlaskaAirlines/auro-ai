+  /**
+   * Whether the trigger should expose `aria-invalid` to assistive technology.
+   *
+   * Parent components (e.g. `auro-select`) bind `error` off their authoritative
+   * `validity` state, so this tracks every cause of invalidity rather than one
+   * of them. Gated on the trigger actually owning a role that supports the
+   * attribute: a focusable slotted trigger (the `auro-input` inside combobox and
+   * datepicker) carries no role here and exposes its own validity, and ARIA 1.2
+   * does not list `button` among the roles supporting `aria-invalid`.
+   * @private
+   * @returns {boolean}
+   */
+  get isInvalid() {
+    return Boolean(this.error) && !this.triggerContentFocusable && this.a11yRole === 'combobox';
+  }
+
