+
+      it('should expose aria-invalid on the trigger when the combobox role is in error', async () => {
+        const el = await fixture(html`<auro-dropdown><div slot="trigger">Trigger</div></auro-dropdown>`);
+        el.a11yRole = 'combobox';
+        await elementUpdated(el);
+
+        const trigger = el.shadowRoot.querySelector('#trigger');
+        await expect(trigger.getAttribute('role')).to.equal('combobox');
+        await expect(trigger.hasAttribute('aria-invalid')).to.be.false;
+
+        el.error = true;
+        await elementUpdated(el);
+
+        await expect(trigger.getAttribute('aria-invalid')).to.equal('true');
+
+        el.error = false;
+        await elementUpdated(el);
+
+        await expect(trigger.hasAttribute('aria-invalid')).to.be.false;
+      });
+
+      it('should not expose aria-invalid on a role="button" trigger', async () => {
+        const el = await fixture(html`<auro-dropdown error><div slot="trigger">Trigger</div></auro-dropdown>`);
+        await elementUpdated(el);
+
+        // ARIA 1.2 does not support aria-invalid on role="button"
+        const trigger = el.shadowRoot.querySelector('#trigger');
+        await expect(trigger.getAttribute('role')).to.equal('button');
+        await expect(el.error).to.be.true;
+        await expect(trigger.hasAttribute('aria-invalid')).to.be.false;
+      });
+
+      it('should not expose aria-invalid when the slotted trigger content is focusable', async () => {
+        const el = await fixture(html`<auro-dropdown error><button slot="trigger">Trigger</button></auro-dropdown>`);
+        el.a11yRole = 'combobox';
+        await elementUpdated(el);
+
+        // The focusable trigger owns its own role and validity exposure
+        const trigger = el.shadowRoot.querySelector('#trigger');
+        await expect(el.error).to.be.true;
+        await expect(trigger.hasAttribute('role')).to.be.false;
+        await expect(trigger.hasAttribute('aria-invalid')).to.be.false;
+      });
     });
 
